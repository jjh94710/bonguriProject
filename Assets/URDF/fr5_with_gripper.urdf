  <!-- ===== Parallel gripper (DH PGI-140-80 style, 40 mm stroke per finger) ===== -->
  <link name="gripper_base_link">
    <inertial>
      <origin xyz="-0.00099 0.00007 0.03850" rpy="0 0 0" />
      <mass value="1.0" />
      <inertia ixx="7.3455e-04" ixy="1.6731e-08" ixz="6.6156e-07" iyy="1.2197e-03" iyz="-6.8896e-07" izz="1.0581e-03" />
